POSTGRES_DB = database
POSTGRES_USER = database-user
POSTGRES_PASSWORD = super-strong-password
POSTGRES_HOST = postgres
POSTGRES_URI = jdbc:postgresql://postgres:5432/database
JWT_SECRET = high-entropy-string
# dev seed data (users visitor@anima.dev / exhibitor@anima.dev, password anima123)
SPRING_PROFILES_ACTIVE=dev
# firebase storage emulator (docker compose points the server container at http://firebase:9199)
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
STORAGE_BUCKET=anima-events.firebasestorage.app
# base of the image urls handed to the app
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9199
# timezone of the server clock; event start times have no zone, so it must match where the users are.
# only one zone is supported (there is no per-request offset)
APP_TIMEZONE=America/Sao_Paulo
